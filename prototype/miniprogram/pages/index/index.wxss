.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #0b0f14;
  color: #d7e2ee;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.camera-wrap {
  position: relative;
  width: 100%;
  height: 54vh;
  flex: none;
  background: #000;
  overflow: hidden;
}

.camera {
  width: 100%;
  height: 100%;
}

.count-layer {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 14px;
  display: flex;
  flex-direction: column;
  align-items: center;
  pointer-events: none;
}

.count {
  font-size: 64px;
  line-height: 1;
  font-weight: 700;
  color: #ffffff;
  text-shadow: 0 2px 12px rgba(0, 0, 0, 0.65);
}

.status {
  margin-top: 6px;
  font-size: 14px;
  color: #b7c7d8;
  text-shadow: 0 1px 6px rgba(0, 0, 0, 0.7);
}

.error-layer {
  position: absolute;
  left: 12px;
  right: 12px;
  top: 12px;
  padding: 10px 12px;
  border-radius: 10px;
  background: rgba(120, 20, 20, 0.88);
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.error-text {
  font-size: 12px;
  line-height: 1.5;
  color: #ffd9d9;
}

.panel {
  flex: 1;
  min-height: 0;
  padding: 10px 12px 24px;
  box-sizing: border-box;
}

.row {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 6px;
}

.metric {
  flex: 1;
  font-size: 12px;
  color: #9fb3c8;
  background: #121a23;
  border-radius: 6px;
  padding: 6px 8px;
  text-align: center;
}

.debug-canvas {
  width: 100%;
  height: 220px;
  margin: 8px 0;
  border-radius: 10px;
  background: #0b0f14;
}

.buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: 6px 0 10px;
}

.buttons button {
  margin: 0;
}

.slider-row {
  display: flex;
  flex-direction: column;
  gap: 2px;
  margin: 4px 0;
}

.slider-label {
  font-size: 12px;
  color: #9fb3c8;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 8px 0;
}

.hint {
  margin-top: 8px;
  font-size: 11px;
  line-height: 1.6;
  color: #6f8296;
}
